---
export interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
}

const { href, title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-us", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<li class="group list-none">
  <a href={href} class="block py-6 outline-none">
    <div class="flex flex-col gap-2">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <h3 class="text-lg font-bold group-hover:text-accent transition-colors decoration-accent/30 decoration-2 underline-offset-4 group-hover:underline">
          {title}
        </h3>
        <time datetime={pubDate.toISOString()} class="text-xs font-mono text-muted-foreground whitespace-nowrap">
          {formattedDate}
        </time>
      </div>
      <p class="text-sm text-muted-foreground line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>
  </a>
</li>
