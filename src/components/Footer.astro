---
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();
---

<footer class="py-12 mt-auto">
  <div class="border-t border-border pt-8 flex flex-col sm:flex-row justify-between items-center gap-6 text-xs font-mono text-muted-foreground uppercase tracking-widest">
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-8">
      <p>&copy; {currentYear} Dong Ming</p>
      <a href="https://github.com/d3ming/dongming.me" class="hover:text-accent transition-colors normal-case tracking-normal">Source</a>
    </div>
    <Socials />
  </div>
</footer>
