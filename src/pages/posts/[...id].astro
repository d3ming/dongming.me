---
import { getCollection, render } from "astro:content";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleUrl = new URL(`/posts/${post.id}`, Astro.site).href;
const imageUrl = new URL(SITE.ogImage, Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: imageUrl,
  datePublished: post.data.pubDatetime.toISOString(),
  dateModified:
    post.data.modDatetime?.toISOString() || post.data.pubDatetime.toISOString(),
  author: {
    "@type": "Person",
    name: post.data.author || SITE.author,
    url: SITE.profile,
  },
  publisher: {
    "@type": "Person",
    name: SITE.author,
    logo: {
      "@type": "ImageObject",
      url: imageUrl,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};
---

<Layout
title={`${post.data.title} | Dong Ming`}
description={post.data.description}
canonicalURL={post.data.canonicalURL}
>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<section class="py-12">
<article class="prose prose-neutral dark:prose-invert max-w-none">
<header class="mb-8">
<h1 class="text-3xl font-bold mb-2">{post.data.title}</h1>
<div class="text-muted-foreground text-sm">
{post.data.pubDatetime.toLocaleDateString("en-US", {
year: 'numeric',
month: 'long',
day: 'numeric'
})}
</div>
</header>
<Content />
</article>

<div class="mt-12 pt-8 border-t border-border">
<a href="/posts" class="text-accent hover:underline decoration-wavy underline-offset-4">
← Back to posts
</a>
</div>
</section>
</Layout>
