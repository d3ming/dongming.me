---
import Hr from "@/components/Hr.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="About | TBD">
  <section class="py-12">
    <h1 class="text-3xl font-bold mb-8 tracking-tight italic">About</h1>

    <div class="space-y-12">
      <div class="prose dark:prose-invert max-w-none text-muted-foreground leading-relaxed">
        <p>
          I'm a software engineer focused on building high-signal, low-noise applications.
          I value performance, accessibility, and clean code.
        </p>
      </div>

      <Hr />

      <div>
        <h2 class="text-xl font-bold mb-4 uppercase tracking-wider text-foreground">Stack</h2>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm font-mono text-muted-foreground">
          <li class="flex items-center gap-2"><span class="text-accent">>&nbsp;</span>TypeScript</li>
          <li class="flex items-center gap-2"><span class="text-accent">>&nbsp;</span>Astro</li>
          <li class="flex items-center gap-2"><span class="text-accent">>&nbsp;</span>React</li>
          <li class="flex items-center gap-2"><span class="text-accent">>&nbsp;</span>Node.js</li>
          <li class="flex items-center gap-2"><span class="text-accent">>&nbsp;</span>Tailwind</li>
          <li class="flex items-center gap-2"><span class="text-accent">>&nbsp;</span>Postgres</li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-bold mb-4 uppercase tracking-wider text-foreground">Contact</h2>
        <p class="text-muted-foreground leading-relaxed">
          The best way to reach me is on <a href="https://x.com/dming" class="text-accent hover:underline underline-offset-4">X (@dming)</a> or
          by checking out my work on <a href="https://github.com/d3ming" class="text-accent hover:underline underline-offset-4">GitHub (@d3ming)</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
